<idea-plugin>
    <id>com.tencent.codebuddy.local</id>
    <name>CodeBuddy Local (Tencent Cloud Code Assistant)</name>
    <version>1.0.2</version>
    <vendor email="support@tencent.com" url="https://cloud.tencent.com">Tencent Cloud</vendor>

    <description><![CDATA[
        <h1>CodeBuddy Local Plugin for PhpStorm</h1>
        <p>A local version of Tencent Cloud's CodeBuddy code assistant for PhpStorm 2021.3.3.</p>
        <p>Features:</p>
        <ul>
            <li>AI-powered code completion and suggestions</li>
            <li>Code refactoring assistance</li>
            <li>Bug detection and fixes</li>
            <li>Code quality analysis</li>
            <li>Local processing with privacy protection</li>
        </ul>
        <p>This plugin brings the power of Tencent Cloud's CodeBuddy directly into your PhpStorm IDE.</p>
    ]]></description>

    <change-notes><![CDATA[
        <h3>Version 1.0.0</h3>
        <ul>
            <li>Initial release for PhpStorm 2021.3.3</li>
            <li>Basic code analysis and suggestions</li>
            <li>Local processing support</li>
        </ul>
    ]]></change-notes>

    <idea-version since-build="213"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.modules.php</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Register our tool window -->
        <toolWindow id="CodeBuddy"
                    anchor="right"
                    factoryClass="com.tencent.codebuddy.ui.CodeBuddyToolWindowFactory"
                    icon="/icons/codebuddy.svg"/>

        <!-- Register code inspection -->
        <localInspection language="JAVA"
                         displayName="CodeBuddy Suggestions"
                         groupName="CodeBuddy"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.tencent.codebuddy.inspection.CodeBuddyInspection"/>

        <!-- Register completion contributor -->
        <completion.contributor language="JAVA"
                                implementationClass="com.tencent.codebuddy.completion.CodeBuddyCompletionContributor"/>

        <!-- Register intention actions -->
        <intentionAction>
            <className>com.tencent.codebuddy.intentions.CodeBuddyRefactorIntention</className>
            <category>CodeBuddy</category>
        </intentionAction>
    </extensions>

    <actions>
        <!-- Main action to open CodeBuddy panel -->
        <action id="CodeBuddy.OpenPanel"
                class="com.tencent.codebuddy.actions.OpenCodeBuddyPanelAction"
                text="Open CodeBuddy"
                description="Open CodeBuddy Assistant Panel">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt C"/>
        </action>

        <!-- Code analysis action -->
        <action id="CodeBuddy.AnalyzeCode"
                class="com.tencent.codebuddy.actions.AnalyzeCodeAction"
                text="Analyze with CodeBuddy"
                description="Analyze current file with CodeBuddy">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>

        <!-- Quick fix action -->
        <action id="CodeBuddy.QuickFix"
                class="com.tencent.codebuddy.actions.QuickFixAction"
                text="CodeBuddy Quick Fix"
                description="Get quick fixes from CodeBuddy">
            <add-to-group group-id="CodeMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>